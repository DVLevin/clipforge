# ---- service ----
HOST=0.0.0.0
PORT=8000
CLIPFORGE_LOG=INFO
# ---- models ----
# rembg model: isnet-general-use (default) | birefnet-general-lite | u2net | isnet-anime
CLIPFORGE_BG_MODEL=isnet-general-use
CLIPFORGE_ALPHA_MATTING=false
# ---- free tier ----
CLIPFORGE_FREE_DAILY_LIMIT=5
CLIPFORGE_MAX_UPLOAD_MB=12
CLIPFORGE_MAX_IMAGE_EDGE=2400
# ---- rate limiting (short window) ----
CLIPFORGE_RPM_LIMIT=20
# ---- persistence ----
CLIPFORGE_DB_PATH=./data/usage.db
# ---- admin (optional; needed for /admin/keys) ----
CLIPFORGE_ADMIN_KEY=
