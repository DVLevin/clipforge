# =============================================================================
# CLIPFORGE backend environment variables.
# Copy to `.env` (gitignored) and fill in real values. Matches app/config.py.
# =============================================================================
# --- platform / server ---
PORT=8000
CLIPFORGE_ENV=production            # development | production
CLIPFORGE_LOG=INFO                  # DEBUG | INFO | WARNING | ERROR

# --- model selection ---
CLIPFORGE_BG_MODEL=isnet-general-use   # rembg model: isnet-general-use | u2net | u2netp | silueta | birenet-general
CLIPFORGE_ALPHA_MATTING=false          # true enables higher-quality hair edges (slower)
CLIPFORGE_MAX_IMAGE_EDGE=1600          # px; images larger than this are downscaled before inference

# --- limits ---
MAX_UPLOAD_MB=15                       # reject uploads larger than this
RATE_LIMIT_PER_MINUTE=20               # slowapi per-key/per-IP rate limit
FREE_DAILY_LIMIT=5                     # free-tier successful inferences per UTC day

# --- auth / admin ---
CLIPFORGE_ADMIN_KEY=change-me-long-random-string   # gates POST /admin/keys; empty = disabled

# --- storage ---
CLIPFORGE_DB_PATH=/data/clipforge.db   # SQLite usage-tracking db (use a volume in prod)

# --- observability (optional) ---
# SENTRY_DSN=https://...@sentry.io/123   # wire into your APM if added later
